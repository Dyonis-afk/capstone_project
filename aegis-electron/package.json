{
  "name": "aegis-electron",
  "private": true,
  "version": "0.1.0-beta.19",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "AEGIS - Active Directory Security Analysis Platform",
  "author": {
    "name": "AEGIS Team",
    "email": "support@aegis-security.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/aegis-electron.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"NODE_ENV=development vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "electron:dist:win": "npm run build && electron-builder --win",
    "electron:dist:mac": "npm run build && electron-builder --mac",
    "electron:dist:linux": "npm run build && electron-builder --linux",
    "electron:dist:all": "npm run build && electron-builder -mwl",
    "electron:publish": "npm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/dagre": "^0.7.53",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "dagre": "^0.8.5",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "figlet": "^1.9.4",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "neo4j-driver": "^6.0.1",
    "posthog-node": "^5.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.2",
    "react-syntax-highlighter": "^16.1.0",
    "react-tooltip": "^5.30.0",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-electron": "^0.29.0",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "build": {
    "appId": "com.aegis.security",
    "productName": "AEGIS",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "build/icons/icon",
    "publish": {
      "provider": "github",
      "owner": "WorldBuilder21",
      "repo": "aegis-releases",
      "releaseType": "release"
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "executableName": "aegis",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "AEGIS Team <support@aegis-security.app>",
      "vendor": "AEGIS Security"
    },
    "extraResources": [
      {
        "from": "electron/docker/docker-compose.yaml",
        "to": "docker-compose.yaml"
      }
    ]
  }
}
